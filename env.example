# Copy this file to .env and fill in your real values.
# .env itself is git-ignored (see .gitignore) -- it will NEVER be
# committed, so this is safe to keep locally with real credentials in it.
# The placeholders below are NOT real -- do not commit real values here
# or anywhere else in the repo.

NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=your-instance-id
